{
  "name": "openday",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Prototype local-first de délibération multi-agents (control plane + extension VS Code)",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
